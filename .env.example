# Public address of this AgentSignal installation, for example https://signal.example.com
APP_ORIGIN=http://localhost:3000
# Required only when using: docker compose --profile https up -d --build
DOMAIN=signal.example.com
# The single website allowed to send reviewed reports, for example https://www.example.com
SITE_ORIGIN=http://localhost:3000
# Any short public label, for example my-site. This is not a secret.
SITE_ID=my-site
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SETUP_TOKEN=replace-with-a-long-random-value
SESSION_SECRET=replace-with-a-different-long-random-value
POSTGRES_PASSWORD=replace-with-a-third-long-random-value
